{
  "appId": "com.edengarden.app",
  "productName": "Eden Garden",
  "icon": "assets/icon.ico",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "assets/**/*"
  ],
  "extraResources": [
    {
      "from": "backend/",
      "to": "backend/",
      "filter": ["**/*", "!__pycache__", "!*.pyc", "!data/**/*"]
    }
  ],
  "asar": true,
  "win": {
    "target": ["portable"],
    "icon": "assets/icon.ico"
  }
}

