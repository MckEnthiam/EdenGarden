{
  "name": "eden-garden",
  "version": "0.1.0",
  "description": "AI-powered course management desktop app",
  "author": "EdenGarden",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently -k \"vite\" \"electronmon .\" --prefix-colors cyan,magenta",
    "electron:build": "npm run build && electron-builder",
    "electron:build:unsigned": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "electron:prep:wincodesign": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prep-winCodeSign.ps1",
    "electron:build:portable": "npm run electron:prep:wincodesign && npm run build && electron-builder",
    "dist": "npm run build && electron-builder --win",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "electron-store": "^8.2.0",
    "googleapis": "^171.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^32.2.6",
    "electron-builder": "^25.1.8",
    "electronmon": "^2.0.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }

}