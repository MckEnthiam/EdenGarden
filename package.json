{
  "name": "eden-garden",
  "version": "0.1.0",
  "description": "AI-powered course management desktop app",
  "author": "EdenGarden",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently -k \"vite\" \"electronmon .\" --prefix-colors cyan,magenta",
    "electron:build": "npm run build && electron-builder",
    "electron:build:unsigned": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "electron:prep:wincodesign": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prep-winCodeSign.ps1",
    "electron:build:portable": "npm run electron:prep:wincodesign && npm run build && electron-builder",
    "predist": "python -m PyInstaller backend/main.py --onefile --name eden-backend --distpath backend-dist --add-data \"backend/db;db\" --add-data \"backend/models;models\" --add-data \"backend/routers;routers\" --add-data \"backend/services;services\" --add-data \"backend/schemas;schemas\" --hidden-import chromadb --hidden-import sentence_transformers --hidden-import easyocr --hidden-import fitz --hidden-import fastapi --hidden-import uvicorn --hidden-import sqlalchemy && copy backend-dist\\eden-backend.exe backend\\eden-backend.exe",
    "dist": "npm run build && electron-builder --win --publish never",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "electron-store": "^8.2.0",
    "googleapis": "^171.4.0",
    "pdfjs-dist": "^4.4.168",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^32.2.6",
    "electron-builder": "^25.1.8",
    "electronmon": "^2.0.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.edengarden.app",
    "productName": "Eden Garden",
    "copyright": "Copyright 2026 Hexaflow",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/",
        "to": "backend/",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!*.pyc",
          "!.venv/**",
          "!*.egg-info/**"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Eden Garden",
      "menuCategory": "Eden Garden",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "artifactName": "EdenGarden-Setup-${version}.exe",
      "license": "LICENSE.txt",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp"
    }
  }
}
